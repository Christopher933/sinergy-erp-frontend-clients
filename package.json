{
  "name": "sinergy-erp-frontend-clients",
  "version": "0.0.124",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node scripts/generate-app-version.js",
    "version:generate": "node scripts/generate-app-version.js",
    "build": "ng build",
    "build:prod": "npm run version:generate && ng build --configuration production --base-href /",
    "build:deploy": "node scripts/build-with-version.js /",
    "deploy": "npm run build:deploy",
    "deploy:both": "node scripts/deploy-both.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/animations": "^21.1.5",
    "@angular/cdk": "~21.1.1",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/material": "~21.1.1",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@primeuix/themes": "^2.0.3",
    "@swimlane/ngx-datatable": "^22.0.0",
    "chart.js": "^4.5.1",
    "exceljs": "^4.4.0",
    "jwt-decode": "^4.0.0",
    "lucide-angular": "^0.563.0",
    "ngx-infinite-scroll": "^21.0.0",
    "ngx-skeleton-loader": "^12.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@angular/build": "^21.2.1",
    "@angular/cli": "^21.1.1",
    "@angular/compiler-cli": "^21.1.0",
    "@angular/material": "^21.1.1",
    "@tailwindcss/postcss": "^4.1.12",
    "cli-truncate": "^6.1.1",
    "fast-check": "^4.5.3",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
